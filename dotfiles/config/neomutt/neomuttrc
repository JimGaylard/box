# Neomutt over TARS's memory labels (~/.mail/agents/tars-memory), via notmuch.
# `folder` points at the maildir root so neomutt never asks to create ~/Mail.
# The sidebar holds one virtual mailbox per memory label: RULES, BOOT, WAKE,
# MEMORY, PROJECTS, IDEAS. Plain `neomutt` opens on RULES.

# macOS ttys claim ^O as the "discard" control char and eat it before
# neomutt sees it, which kills the Ctrl-o sidebar-open binding. The fix
# lives in zshrc.d/neomutt.zsh: an alias runs `stty discard undef` in the
# shell that owns the tty before neomutt starts. An in-config backtick was
# tried and does NOT work — the subshell's stdin is not reliably the
# terminal (proven 2026-08-11).

set mbox_type = Maildir
set folder = ~/.mail/agents
set spool_file = "notmuch://?query=path:agents/tars-memory/** and not tag:superseded and not AtomStatus:retired and not AtomKind:label and Refs:\"1790234765.7020.11463@Jims-MacBook-Pro.session-mail\""
set record = ""
set move = no
set copy = no
set mark_old = no

# Sidebar carries the six memory-label mailboxes, defined further down as
# virtual-mailboxes. X still opens an ad-hoc notmuch query.

# Sidebar: all mailboxes visible with new-mail counts. ] and [ move the
# highlight, Ctrl-o opens it. (Ctrl-h/j/k/l belong to vim-tmux-navigator
# at tmux root — see ~/box dotfiles/tmux.conf.)
set sidebar_visible = yes
set sidebar_width = 42
set sidebar_short_path = yes
set sidebar_folder_indent = no
set sidebar_delim_chars = "/"
set sidebar_format = "%D%?F? [%F]?%*  %?N?%N/?%S"
set mail_check_stats = yes
bind index,pager ] sidebar-next
bind index,pager [ sidebar-prev
bind index,pager \Co sidebar-open

# Sidebar colors: new mail pops green, the selected box gets a cyan block,
# the divider fades into the background.
color sidebar_new brightgreen default
color sidebar_indicator black brightcyan
color sidebar_highlight white color8
color sidebar_divider color8 default

# Threaded view; threads only link where mails carry In-Reply-To/References
# (agent-mail sets both when the sender passes --in-reply-to).
set sort = reverse-threads
set sort_aux = last-date-received

# Threading ergonomics: only real reference headers thread, jump follows new
# mail out of collapsed threads, za/zA fold like vim.
set strict_threads = yes
set uncollapse_jump = yes
bind index za collapse-thread
bind index zA collapse-all
color tree brightmagenta default

# Notmuch: same maildirs, indexed. %g shows notmuch tags in the index.
# X prompts for a notmuch query and opens it as a virtual folder;
# + pulls the entire thread of the current message into view.
set nm_default_url = "notmuch:///Users/jimg/.mail"
# Relative dates: time for today, month+day this year, full date otherwise.
set index_format = "%4C %Z %<[y?%<[d?%[%H:%M   ]&%[%b %d  ]>&%[%y-%m-%d]> %-28.28F %s %g"
# One virtual mailbox per TARS memory label. A label's items carry its label
# root's Message-ID in References, so each query keys on that root. The root
# Message-IDs below are stable content ids, not environment values. notmuch
# indexes the References header as `Refs` (index.header.Refs=References) and
# Atom-Status as AtomStatus. Every query drops superseded items
# (tag:superseded), retired items (AtomStatus:retired) and the label nodes
# themselves (AtomKind:label). BOOT also drops WAKE items, which reference both
# roots because the WAKE label is a child of BOOT.
virtual-mailboxes "RULES" "notmuch://?query=path:agents/tars-memory/** and not tag:superseded and not AtomStatus:retired and not AtomKind:label and Refs:\"1790234765.7020.11463@Jims-MacBook-Pro.session-mail\""
virtual-mailboxes "BOOT" "notmuch://?query=path:agents/tars-memory/** and not tag:superseded and not AtomStatus:retired and not AtomKind:label and Refs:\"1790234765.7138.15436@Jims-MacBook-Pro.session-mail\" and not Refs:\"1790234816.33288.22291@Jims-MacBook-Pro.session-mail\""
virtual-mailboxes "WAKE" "notmuch://?query=path:agents/tars-memory/** and not tag:superseded and not AtomStatus:retired and not AtomKind:label and Refs:\"1790234816.33288.22291@Jims-MacBook-Pro.session-mail\""
virtual-mailboxes "MEMORY" "notmuch://?query=path:agents/tars-memory/** and not tag:superseded and not AtomStatus:retired and not AtomKind:label and Refs:\"1790234765.7256.30576@Jims-MacBook-Pro.session-mail\""
virtual-mailboxes "PROJECTS" "notmuch://?query=path:agents/tars-memory/** and not tag:superseded and not AtomStatus:retired and not AtomKind:label and Refs:\"1790234765.7374.17159@Jims-MacBook-Pro.session-mail\""
virtual-mailboxes "IDEAS" "notmuch://?query=path:agents/tars-memory/** and not tag:superseded and not AtomStatus:retired and not AtomKind:label and Refs:\"1790234766.7493.29428@Jims-MacBook-Pro.session-mail\""
bind index,pager X vfolder-from-query
bind index,pager + entire-thread

# Index colors: cyan bar on the current row; new green, flagged red,
# deleted dimmed.
color indicator black brightcyan
color index brightgreen default ~N
color index brightred default ~F
color index color8 default ~D

# Message-type colors by subject tag — last-match-wins, so these sit after
# the general index rules above to take precedence.
color index brightred default "~s \\[blocker\\]"
color index brightyellow default "~s \\[question\\]"

# Status bar: folder, counts that only appear when non-zero, position at
# the right edge.
set status_format = " %f  %m msgs%?n? | %n new?%?F? | %F flagged?%?t? | %t tagged? %> %P "
color status black cyan

# Pager headers: hide everything except the few that matter, in a fixed
# order; subject stands out.
ignore *
unignore From: To: Cc: Date: Subject: X-Type:
hdr_order From: To: Cc: Date: Subject: X-Type:
color hdrdefault cyan default
color header brightwhite default "^Subject:"

# Pager niceties: mini-index above the message, no scroll-past-end, a
# little context on page turns, no wrap markers, colored quotes and URLs.
set pager_index_lines = 8
set pager_stop = yes
set pager_context = 3
set markers = no
color quoted green default
color quoted1 magenta default
color body brightblue default "https?://[^ ]+"

# Faster refresh: poll the maildirs often and never sit on a key prompt.
set timeout = 10
set mail_check = 5
set wait_key = no
set sleep_time = 0
